# RPC endpoints. The name on each line (BASE_RPC_1, ...) is referenced by [[rpc]] in config.toml.
# URLs contain API keys, so real values go in .env (gitignored) — never in this example, in code,
# or in logs. Logs and errors may show only the endpoint NAME.
BASE_RPC_1=https://your-endpoint-1
BASE_RPC_2=https://your-endpoint-2
# OTHER_RPC_1=https://your-endpoint     # endpoints for another chain
