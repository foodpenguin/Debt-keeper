# Shadow-mode liquidation bot (never sends transactions). Installed by scripts/setup_wsl.sh
# --install-service with @BIN@ / @CONFIG@ / @LOG@ / @WORKDIR@ / @USER@ filled in (BIN, CONFIG, LOG, WORKDIR overridable:
# e.g. a private build of the bot and a config kept outside this repository).
#   sudo systemctl status debt-keeper-shadow     # state
#   sudo systemctl restart debt-keeper-shadow    # after a rebuild
#   sudo systemctl stop debt-keeper-shadow       # before starting `watch --live` by hand
# Live mode is never started by systemd: it needs the keystore password, typed by a person.
[Unit]
Description=Liquidation bot (shadow mode)
Wants=network-online.target
After=network-online.target
# Never give up restarting: a multi-day RPC outage (seen 2026-11-13, a flaky endpoint tripped a
# crash loop that hit the old 10-starts/10-min limit and systemd stopped the bot for 4 days) must
# not permanently stop it. The back-off below, not a start limit, keeps a crash loop gentle.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKDIR@
ExecStart=@BIN@ -c @CONFIG@ watch
Environment=NO_COLOR=1
Environment=RUST_LOG=info
# Restart after crashes or RPC outages, backing off from 15 s up to 5 min as failures repeat
# (systemd >= 254; the VM runs 255), so a persistent outage retries slowly instead of giving up.
Restart=always
RestartSec=15
RestartSteps=5
RestartMaxDelaySec=300
StandardOutput=append:@LOG@
StandardError=append:@LOG@
# Shadow mode needs no privileges.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
